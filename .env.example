# Адрес, по которому сайт доступен снаружи. На него Higgsfield шлёт вебхуки,
# поэтому в бою обязательно https.
PUBLIC_BASE_URL=https://qaitala.kz

POSTGRES_PASSWORD=
DATABASE_URL=postgres://qaitala:@localhost:5432/qaitala?sslmode=disable

# Kaspi. tokenSN и vtokenSecret берутся один раз: поднимаешь веб-интерфейс
# kaspi-сервиса, проходишь SMS-авторизацию, копируешь значения сюда.
# Протухают — оплата встаёт, в логах будет "СЕССИЯ KASPI НЕДЕЙСТВИТЕЛЬНА".
KASPI_TOKEN_SN=
KASPI_VTOKEN_SECRET=
KASPI_PROFILE_ID=
# Тот же секрет, что в webhooks.json у kaspi-сервиса
KASPI_WEBHOOK_SECRET=
# openssl rand -hex 32
KASPI_TOKEN_SECRET_KEY=

# Higgsfield, console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Любая случайная строка: попадает в путь вебхука и отсекает посторонний шум.
# Подписи у вебхуков Higgsfield нет, поэтому результат всё равно
# перепроверяется запросом status_url.
HF_WEBHOOK_SECRET=

# Хранилище: Cloudflare R2 по S3-протоколу.
# Account ID и ключи — в R2 → API → Manage API tokens.
# Эндпоинт собирается сам: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_TYPE=r2
R2_ACCOUNT_ID=
# Токен с правами Object Read & Write, scope — только эта корзина
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Custom domain корзины: по нему читается public/ без подписи.
# Дев-адрес pub-*.r2.dev в бой не ставить — он рейт-лимитится.
# ВАЖНО: в R2 публична вся корзина целиком. То, что orders/* (фото клиентов и
# готовые ролики) не читается по этому адресу, держится на WAF custom rule
# в зоне домена:
#   (http.host eq "<домен из R2_PUBLIC_URL>" and
#    not starts_with(http.request.uri.path, "/public/"))  →  Block
R2_PUBLIC_URL=https://cdn.qaitala.kz

# Сколько генераций одновременно. Выше лимита аккаунта Higgsfield нельзя:
# он отвечает 400 и не ставит задачу в очередь.
WORKER_CONCURRENCY=2

# Прогон всего потока без обращения к Kaspi и Higgsfield — и без трат.
FAKE_PAYMENTS=false
FAKE_VIDEO=false
